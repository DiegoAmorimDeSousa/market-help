# Token do seu bot (pegue com o @BotFather no Telegram)
TELEGRAM_TOKEN=

# Opcional: seu chat id. Se ficar vazio, quem mandar /start primeiro vira o dono do bot.
TELEGRAM_CHAT_ID=

# De quantos em quantos minutos verificar as promoções
CHECK_INTERVAL_MIN=10

# Ignorar promoções publicadas há mais de X horas
MAX_AGE_HOURS=48
